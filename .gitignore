# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# generated test and browser state
/coverage/
/playwright-report/
/reports/
/test-results/
/.stryker-tmp
/.lighthouseci/
/artifacts/lighthouse/
/artifacts/browser-performance/
/artifacts/latency/

# generated web build and route types
/build
/.react-router/
/packages/**/dist/
**/storybook-static/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# local workspace data: SQLite, profiles, sources, runs, and exports
/data/
*.sqlite
*.sqlite-*

# local agent and design-tool state
/AGENTS.md
/CLAUDE.md
/.handoff/
/.agents/
/.claude/
/.codex/
/.claude/settings.local.json
/.impeccable/
