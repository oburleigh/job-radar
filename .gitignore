# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# generated test and browser state
/coverage/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local workspace data: SQLite, profiles, sources, runs, and exports
/data/

# local agent and design-tool state
/AGENTS.md
/CLAUDE.md
/.agents/
/.claude/
/.codex/
/.claude/settings.local.json
/.impeccable/config.local.json
/.impeccable/hook.cache.json
/.impeccable/live/
/.impeccable/review/
/.impeccable/mocks/
/.impeccable/surfaces/
