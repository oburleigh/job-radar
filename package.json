{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm packages:build && react-router build",
    "start": "pnpm setup:check && cross-env HOST=127.0.0.1 NODE_OPTIONS=--import=dotenv/config react-router-serve build/server/index.js",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "typecheck": "pnpm packages:build && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "packages:build": "pnpm --filter './packages/**' --if-present run build",
    "storybook": "pnpm --filter @job-radar/web-docs storybook",
    "storybook:build": "pnpm --filter @job-radar/web-docs build",
    "prepare": "lefthook install",
    "setup:check": "tsx scripts/check-prerequisites.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "pnpm setup:check --database-only && pnpm db:migrate",
    "discover": "tsx scripts/discover.ts",
    "reindex": "tsx scripts/reindex.ts",
    "sync": "tsx scripts/sync.ts",
    "verify:linkedin": "tsx scripts/verify-linkedin.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@job-radar/design-ui": "workspace:^",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "isbot": "^5",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "lefthook": "^2.1.10",
    "tsx": "4.23.12",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
