{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "react-router dev --force --strictPort",
    "build": "pnpm packages:build && react-router build",
    "build:verification": "cross-env JOB_RADAR_BUILD_DIRECTORY=build/verification pnpm build",
    "start": "pnpm setup:check && cross-env HOST=127.0.0.1 NODE_OPTIONS=--import=dotenv/config react-router-serve build/server/index.js",
    "lint": "biome check --error-on-warnings . && pnpm lint:workflows",
    "lint:fix": "biome check --write --error-on-warnings .",
    "lint:workflows": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 && node scripts/check-github-actions.ts",
    "typecheck": "pnpm packages:build && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:focused": "stryker run stryker.focused.config.mjs",
    "performance:size": "size-limit",
    "test:performance:size": "pnpm build:verification && cross-env JOB_RADAR_BUILD_DIRECTORY=build/verification pnpm performance:size",
    "serve:lighthouse": "pnpm exec tsx tests/support/lighthouse-server.ts",
    "performance:lighthouse": "lhci autorun",
    "test:performance:lighthouse": "pnpm build:verification && cross-env JOB_RADAR_BUILD_DIRECTORY=build/verification pnpm performance:lighthouse",
    "performance:browser": "playwright test --config playwright.performance.config.ts",
    "test:performance:browser": "pnpm build:verification && cross-env JOB_RADAR_BUILD_DIRECTORY=build/verification pnpm performance:browser",
    "probe:performance:browser": "cross-env JOB_RADAR_PERFORMANCE_PROBE=slow-interaction pnpm performance:browser",
    "performance:latency": "tsx scripts/measure-performance-latency.ts",
    "test:performance:latency": "pnpm build:verification && cross-env JOB_RADAR_BUILD_DIRECTORY=build/verification pnpm performance:latency",
    "performance:all": "pnpm performance:size && pnpm performance:lighthouse && pnpm performance:browser && pnpm performance:latency",
    "test:performance": "pnpm build:verification && cross-env JOB_RADAR_BUILD_DIRECTORY=build/verification pnpm performance:all",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:e2e": "pnpm test:browser && pnpm test:e2e:web-search-real",
    "test:e2e:web-search-real": "playwright test --config playwright.web-search-real.config.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "packages:build": "pnpm --filter './packages/**' --if-present run build",
    "storybook": "pnpm --filter @job-radar/web-docs storybook",
    "storybook:build": "pnpm --filter @job-radar/web-docs build",
    "prepare": "lefthook install",
    "setup:check": "tsx scripts/check-prerequisites.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "pnpm setup:check --database-only && pnpm db:migrate",
    "discover": "tsx scripts/discover.ts",
    "evaluate:discovery": "tsx scripts/evaluate-discovery.ts",
    "reindex": "tsx scripts/reindex.ts",
    "sync": "tsx scripts/sync.ts",
    "verify:linkedin": "tsx scripts/verify-linkedin.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@job-radar/design-ui": "workspace:^",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@tansuasici/country-state-city": "3.0.0",
    "better-sqlite3": "13.0.3",
    "country-to-currency": "^3.0.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "isbot": "^5",
    "iso-3166": "4.4.0",
    "lucide-react": "1.33.0",
    "p-queue": "9.3.3",
    "p-retry": "8.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "react-virtuoso": "4.18.12",
    "sonner": "2.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.0",
    "@size-limit/file": "13.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autocannon": "8.0.0",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "lefthook": "^2.1.10",
    "size-limit": "13.0.3",
    "tsx": "4.23.12",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "web-vitals": "6.1.1"
  }
}
