{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!docs/audits",
      "!**/.react-router",
      "!**/.lighthouseci",
      "!**/build",
      "!**/coverage",
      "!**/data",
      "!**/dist",
      "!**/node_modules",
      "!**/playwright-report",
      "!**/reports",
      "!**/test-results",
      "!**/artifacts",
      "!**/storybook-static",
      "!**/.impeccable",
      "!**/.worktrees",
      "!**/.agents/skills",
      "!**/.claude/skills",
      "!**/.codex",
      "!drizzle/meta",
      "!public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "all",
      "test": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noEnum": "error",
        "noHexColors": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Use the @/ application alias for imports outside the current directory. Shared workspaces must use their package name."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    // Release Please writes compact JSON, which the repository formatter would rewrite.
    {
      "includes": [".release-please-manifest.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/design-tokens/src/theme.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
